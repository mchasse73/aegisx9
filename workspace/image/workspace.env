# AegisX9 workspace defaults. Every value here is rendered into
# /etc/claude-code/managed-settings.json at IMAGE BUILD time by render_settings.py and
# installed as /etc/aegisx9/workspace.env (root-owned, read-only) for the helper tools.
# Override any value with a Docker build arg of the same name. None of these is a secret.
#
# Placeholders: replace <gateway-host>, <otlp-host> and <vault-host> with the company's
# hostnames in the build (see workspace/README.md). The image refuses to build with a
# placeholder left in place.
AEGISX9_ENVIRONMENT=staging
AEGISX9_GATEWAY_URL=https://<gateway-host>
AEGISX9_OTLP_ENDPOINT=https://<otlp-host>
AEGISX9_VAULT_ADDR=https://<vault-host>
# Comma-separated model allowlist offered to developers (the gateway enforces it too).
AEGISX9_MODELS=claude-sonnet-4-5,claude-haiku-4-5
# Comma-separated models that are never offered, even if the gateway would allow them.
AEGISX9_DENIED_MODELS=
# Extra hosts the Bash sandbox may reach. The gateway, OTLP and Vault hosts are added
# automatically from the URLs above.
AEGISX9_SANDBOX_DOMAINS=github.com
# How long Claude Code caches the apiKeyHelper result (55 min: below the 1 h token TTL).
AEGISX9_API_KEY_HELPER_TTL_MS=3300000
