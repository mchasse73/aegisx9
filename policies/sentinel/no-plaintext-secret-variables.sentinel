# Any variable whose name suggests a credential must be `sensitive = true` and must not
# have a default value (so no secret can be committed in configuration). Applies to the
# root module and every module call, recursively.
import "tfplan/v2" as tfplan

secret_name_re = "(?i)(secret|token|password|passwd|api_?key|private_?key|credential)"

check_module = func(address, module) {
	found = []
	for (module.variables else {}) as name, v {
		if name matches secret_name_re {
			if not (v.sensitive else false) {
				append(found, address + "var." + name + " is not sensitive")
			}
			if "default" in keys(v) {
				append(found, address + "var." + name + " has a default value")
			}
		}
	}
	for (module.module_calls else {}) as call, mc {
		for check_module(address + "module." + call + ".", mc.module else {}) as f {
			append(found, f)
		}
	}
	return found
}

violations = check_module("", tfplan.raw.configuration.root_module else {})

for violations as v {
	print(v)
}

main = rule {
	length(violations) is 0
}
