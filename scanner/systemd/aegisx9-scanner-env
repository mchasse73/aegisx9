#!/bin/bash
# AegisX9 external vantage: boot-time secrets fetcher (installed to /usr/local/sbin, 0700).
#
# Reads parameter NAMES and non-secret settings from /etc/aegisx9-scanner/env-source.conf,
# fetches each SecureString from the SSM Parameter Store with the instance role, and writes
# every value by redirection into a 0600 root-owned file. No value is ever echoed, logged,
# placed on a command line or written into the env file. Never add `set -x` here.
set -euo pipefail
umask 077

# The directory is overridable only so the tests can run this script unprivileged.
DIR="${AEGISX9_SCANNER_ENV_DIR:-/etc/aegisx9-scanner}"
CONF="${DIR}/env-source.conf"
if [ ! -r "${CONF}" ]; then
  echo "aegisx9-scanner-env: ${CONF} missing" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "${CONF}"

: "${AWS_REGION:?AWS_REGION missing in env-source.conf}"
: "${WEBHOOK_URL_PARAMETER:?}" "${WEBHOOK_SECRET_PARAMETER:?}"
: "${TUNNEL_SECRET_PARAMETER:?}" "${REDTEAM_KEY_PARAMETER:?}"
export AWS_REGION

# log <level> <message>: one JSON line per event, like the scanner. Parameter NAMES only;
# a value, and the AWS CLI's own error text, never reach a log line.
log() {
  printf '{"level":"%s","logger":"aegisx9-scanner-env","msg":"%s"}\n' "$1" "$2" >&2
}

failed=0

# fetch <required|optional> <parameter name> <destination file>
# The value travels from the AWS CLI's stdout straight into the file (0600, root).
#  * required: any failure (unreadable, absent, empty) is an error. The destination is
#    removed rather than left empty and the script exits non-zero at the end, so the
#    service fails and the scan units (Requires=) do not start on a missing secret.
#  * optional: an ABSENT parameter is informational and leaves an empty file so the
#    units' LoadCredential= still finds it. Any other failure (access denied, the CLI
#    cannot run) is logged as an error but does not fail the service.
fetch() {
  local need="$1" name="$2" dest="$3" tmp errf reason
  tmp="$(mktemp "${DIR}/.fetch.XXXXXX")"
  errf="$(mktemp "${DIR}/.fetch-err.XXXXXX")"
  if aws ssm get-parameter --with-decryption --name "${name}" \
      --query Parameter.Value --output text > "${tmp}" 2> "${errf}"; then
    # strip the trailing newline the CLI adds
    printf '%s' "$(cat "${tmp}")" > "${tmp}"
    reason=""
    [ -s "${tmp}" ] || reason="empty"
  elif grep -q '(ParameterNotFound)' "${errf}"; then
    reason="absent"
  elif grep -q '(AccessDenied' "${errf}"; then
    reason="access_denied"
  else
    reason="fetch_failed"
  fi
  rm -f "${errf}"
  if [ -z "${reason}" ]; then
    chmod 0600 "${tmp}"
    mv -f "${tmp}" "${dest}"
    log info "parameter fetched: ${name}"
    return 0
  fi
  if [ "${need}" = "required" ]; then
    rm -f "${tmp}" "${dest}"
    log error "required parameter not readable (${reason}): ${name}"
    failed=1
    return 0
  fi
  if [ "${reason}" = "absent" ]; then
    log info "optional parameter absent: ${name} (empty file)"
  else
    log error "optional parameter not readable (${reason}): ${name} (empty file)"
  fi
  : > "${tmp}"
  chmod 0600 "${tmp}"
  mv -f "${tmp}" "${dest}"
}

if ! command -v aws >/dev/null 2>&1; then
  log error "aws cli not found: no parameter can be read"
  exit 1
fi

# The red-team key is required only when a red-team target is configured.
redteam_need=optional
if [ -n "${REDTEAM_TARGET_URL:-}" ]; then
  redteam_need=required
fi

fetch required "${WEBHOOK_SECRET_PARAMETER}" "${DIR}/webhook_secret"
fetch required "${WEBHOOK_URL_PARAMETER}"    "${DIR}/webhook_url"
fetch optional "${TUNNEL_SECRET_PARAMETER}"  "${DIR}/tunnel_secret"
fetch "${redteam_need}" "${REDTEAM_KEY_PARAMETER}" "${DIR}/redteam_key"

if [ "${failed}" -ne 0 ]; then
  log error "required parameters missing: the scan units will not start"
  exit 1
fi

# Non-secret environment for the scan units. The secret *_FILE paths are set by the
# units themselves (LoadCredential=), not here, so this file never names a secret.
tmp_env="$(mktemp "${DIR}/.env.XXXXXX")"
{
  echo "# Written at boot by aegisx9-scanner-env. Non-secret settings only."
  printf 'AEGISX9_SCANNER_WEBHOOK_URL=%s\n' "$(cat "${DIR}/webhook_url")"
  printf 'AEGISX9_SCANNER_AWS_REGION=%s\n' "${AWS_REGION}"
  printf 'AEGISX9_SCANNER_SES_FROM=%s\n' "${SES_FROM:-}"
  printf 'AEGISX9_SCANNER_SES_TO=%s\n' "${SES_TO:-}"
  printf 'AEGISX9_SCANNER_REDTEAM_TARGET_URL=%s\n' "${REDTEAM_TARGET_URL:-}"
  printf 'AEGISX9_SCANNER_REDTEAM_MODEL=%s\n' "${REDTEAM_MODEL:-}"
  printf 'AEGISX9_SCANNER_ALERT_MIN_SEVERITY=%s\n' "${ALERT_MIN_SEVERITY:-medium}"
  if [ "${VAULT_AWS_AUTH_ENABLED:-false}" = "true" ]; then
    # TODO(platform operations): Vault AWS IAM auth. The host authenticates with its
    # instance role; no Vault secret is stored on the box. Paths are not decided here.
    printf 'VAULT_ADDR=%s\n' "${VAULT_ADDR:-}"
    printf 'VAULT_AUTH_ROLE=%s\n' "${VAULT_AUTH_ROLE:-}"
  fi
} > "${tmp_env}"
chmod 0600 "${tmp_env}"
mv -f "${tmp_env}" "${DIR}/env"
log info "secrets refreshed into ${DIR} (0600 root)"
